# Gradle
.gradle/
build/
!build-logic/
# `build/` above matches any directory of that name, including the Kotlin
# package the convention plugins' task classes live in. That is source, not
# output, and leaving it ignored silently kept it out of the repository.
!build-logic/src/main/kotlin/de/drehtuer/dinfinity/build/
local.properties

# Android
*.apk
*.aab
*.dex
captures/
.cxx/

# Signing keys — never commit these. Generate them with the commands in
# docs/build-setup.md; keystore/keystore.properties holds their passwords.
keystore/*
!keystore/README.md
# The certificate's fingerprint is public by design — it is what proves a
# downloaded APK was signed by this project's key. The key itself is not.
!keystore/release-certificate.sha256
*.keystore
*.jks
keystore.properties

# Python — `tools/` is run by hand from the repository root, and the bytecode
# cache it leaves behind is output, not tooling.
__pycache__/
*.pyc

# IDE
.idea/
*.iml
.kotlin/

# OS
.DS_Store
