<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
  <string name="roll_formula_label">Formula</string>
  <!-- The set a group's dice actually came from, when it is not the one asked for. -->
  <string name="roll_group_fell_back">from %1$s</string>
  <!--
    Why a group stopped throwing dice, printed under its row. Both describe a
    die that is *not* on the sheet, which is the only thing a breakdown cannot
    show by showing the dice (`docs/dice-notation.md`, "Limits").
    %1$d is the explosion depth limit.
  -->
  <plurals name="roll_group_explosion_limit">
    <item quantity="one">Exploding stopped at %1$d die.</item>
    <item quantity="other">Exploding stopped at %1$d dice.</item>
  </plurals>
  <string name="roll_group_tray_full">The tray had no room for another die.</string>
  <!-- Division rounding, offered for this throw only (design option 6d). -->
  <string name="roll_rounding_label">Rounding</string>
  <string name="roll_rounding_down">Down</string>
  <string name="roll_rounding_nearest">Nearest</string>
  <string name="roll_rounding_up">Up</string>
  <!--
    Dice notation, not prose: the "-" is the subtraction operator the parser
    reads, and an en dash is not something the player could type back
    (`docs/dice-notation.md`).
  -->
  <string name="roll_formula_hint" tools:ignore="TypographyDashes">3d6 + 1d20 - 4</string>
  <!-- First launch (design option 9a). Each count is its own plural and they
       are joined with a separator, so a language that pluralises differently
       from English still reads. %1$d is the count in every one of them. -->
  <string name="roll_welcome_eyebrow">FIRST LAUNCH</string>
  <string name="roll_welcome_title">Nothing to set up.</string>
  <string name="roll_welcome_body">The dice are installed and the table is laid out. Shake the phone to roll — that is the only way to throw, and it is the one thing nobody would guess. Everything else — saved rolls, your own dice, statistics — waits in the menu until you want it.</string>
  <plurals name="roll_welcome_sets">
    <item quantity="one">%1$d dice set</item>
    <item quantity="other">%1$d dice sets</item>
  </plurals>
  <plurals name="roll_welcome_saved">
    <item quantity="one">%1$d saved roll</item>
    <item quantity="other">%1$d saved rolls</item>
  </plurals>
  <plurals name="roll_welcome_sessions">
    <item quantity="one">%1$d session</item>
    <item quantity="other">%1$d sessions</item>
  </plurals>
  <!-- Quoted: Android strips the spaces around it otherwise. -->
  <string name="roll_welcome_counts_separator" translatable="false">" · "</string>
  <string name="roll_welcome_roll_now">Put a d20 on the table</string>
  <string name="roll_welcome_dismiss">Just show me the tray</string>
  <string name="roll_welcome_import">Import saved rolls from a file or a link</string>
  <string name="roll_welcome_sets_add">Add somebody else\'s dice</string>
  <!-- A number the formula adds or takes away, itemised on the result sheet. -->
  <string name="roll_sheet_plus">plus</string>
  <string name="roll_sheet_minus">minus</string>
  <!-- The two pull-ups' handles: what each is, what a tap on it does, and
       where it is now. Said rather than drawn, because the bar looks the same
       in both rests and a screen reader has nothing else to go on. -->
  <string name="roll_result_handle">Result sheet</string>
  <string name="roll_result_push_down">Push the result down to see the table</string>
  <string name="roll_result_pull_up">Pull the result up to see the breakdown</string>
  <string name="roll_result_is_up">Showing the breakdown</string>
  <string name="roll_result_is_down">Pushed down</string>
  <string name="roll_saved_handle">Saved rolls</string>
  <string name="roll_saved_kicker">SAVED ROLLS</string>
  <string name="roll_saved_pull_up">Pull the saved rolls up</string>
  <string name="roll_saved_push_down">Put the saved rolls away</string>
  <string name="roll_saved_is_up">Showing the saved rolls</string>
  <string name="roll_saved_is_down">Put away</string>
  <!-- Quick mode: what a long press on a die in the breakdown offers (docs/face-designer.md). -->
  <string name="roll_die_doodle">Doodle this die</string>
  <!--
    The hint on a tray with a throw ready (design option 9a). There is no
    matching one for an empty tray any more: the second device session asked
    for `Type a formula, or open Dice at the top.` to go, and with the formula
    behind a tab of its own there is nothing on the felt for it to point at.
  -->

  <!--
    The way back, for a throw that came from the face designer's "Roll it"
    (docs/face-designer.md). The second line is also what a screen reader is
    told the banner does, so it has to read as an action on its own.
  -->
  <string name="roll_testing_your_die">Testing the die you drew</string>
  <string name="roll_back_to_designer">Back to the face designer</string>
  <string name="roll_hint_ready">Shake the phone to roll.</string>
  <!-- The dice picker row (design option 1h). %1$s is a die, e.g. "d20". -->
  <string name="roll_picker_add">Add a %1$s</string>
  <string name="roll_picker_remove">Take a %1$s off</string>
  <!--
    The dice pull-down at the top of the tray (design option 1h): what it is,
    what a press does, and whether it is open. The last two are said rather
    than drawn, because a chevron is a picture and a screen reader has nothing
    else to go on.
  -->
  <string name="roll_dice_menu">Dice</string>
  <string name="roll_dice_menu_open">Open the dice</string>
  <string name="roll_dice_menu_close">Put the dice away</string>
  <string name="roll_dice_menu_is_open">Open</string>
  <string name="roll_dice_menu_is_shut">Closed</string>
  <!--
    The formula's tab at the right-hand edge (design option 2a): what is behind
    it, what a press does, and what state it is in. The last of those has a
    third reading, because the shut tab turns red for a formula that does not
    read and red is not something a screen reader can say.
  -->
  <string name="roll_formula_open">Bring the formula in</string>
  <string name="roll_formula_close">Put the formula away</string>
  <string name="roll_formula_is_open">Open</string>
  <string name="roll_formula_is_shut">Closed</string>
  <string name="roll_formula_is_shut_wrong">Closed, and the formula does not read</string>
  <!-- The two ways on from a result, at the foot of the sheet (options 7a, 3b). -->
  <string name="roll_see_the_odds">See the odds</string>
  <string name="roll_save_as_roll">Save as roll</string>
  <!--
    The tray's custom accessibility action. Shaking is the only way to throw
    and a shake is not a gesture every hand can make, so the table carries the
    throw as an action a screen reader can offer (`docs/architecture.md`,
    "Accessibility").
  -->
  <string name="roll_throw_action">Throw the dice</string>
  <string name="roll_rolling">Rolling…</string>
  <!--
    The counting plate, across the bottom of the tray while the dice are still
    being read (`docs/physics-and-rendering.md`, "What is drawn over the
    table"). The kicker is upper case in the string rather than transformed,
    because Compose has no text transform and uppercasing a string changes what
    a screen reader says.
  -->
  <string name="roll_counting_kicker">COUNTING</string>
  <plurals name="roll_counting_read">
    <item quantity="one">of %1$d read</item>
    <item quantity="other">of %1$d read</item>
  </plurals>
  <!-- Where the finished roll can still come out, ordered low to high. -->
  <string name="roll_counting_range">%1$d to %2$d</string>
  <!--
    A chain that has not stopped can still earn dice nobody has thrown, so the
    ceiling is what the throw can reach without earning another one and this
    says it can go higher. An operator rather than a word.
  -->
  <string name="roll_counting_more" translatable="false">+</string>
  <!-- The ceiling of a roll that can still explode: "48+" rather than "48". -->
  <string name="roll_ceiling_more">%1$d+</string>
  <!--
    What a throw is expected to come to, before it is made and again beside
    what it actually did (`Expectation`, `docs/probability.md`). The average is
    exact rather than sampled, and is missing for a formula past what the
    outcome graph computes — which is why the two spoken forms exist.
  -->
  <string name="roll_expected_kicker">EXPECTED</string>
  <string name="roll_expected_average">avg %1$.1f</string>
  <string name="roll_expected_spoken">Expected %1$d to %2$s</string>
  <string name="roll_expected_spoken_average">Expected %1$d to %2$s, average %3$s</string>
  <!--
    The whole plate, for a screen reader: it is a row of numbers an eye reads
    at a glance and a listener would otherwise hear as four loose fragments.
  -->
  <plurals name="roll_counting">
    <item quantity="one">%1$d of %2$d die read · %3$d to %4$s</item>
    <item quantity="other">%1$d of %2$d dice read · %3$d to %4$s</item>
  </plurals>
  <!--
    Where a roll that is waiting on a hand can still come out: on the plate a
    chain waits on and on the one a roll that gave up waits on. The same
    figures the counting plate draws while the dice are moving, kept on screen
    for as long as the roll is owed a shake.
  -->
  <string name="roll_still_kicker">STILL TO COME</string>
  <string name="roll_still_spoken">Still to come, %1$d to %2$s</string>
  <!--
    A chain that has stopped and is one throw short. The dice that are down
    stay down; the app does not throw the die an explosion earned
    (`docs/dice-notation.md`, "Evaluation").
  -->
  <string name="roll_earned_kicker">ANOTHER THROW EARNED</string>
  <plurals name="roll_earned_body">
    <item quantity="one">A die rolled its highest face and earned a throw. The dice that are down stay down — shake to throw the one they earned.</item>
    <item quantity="other">%1$d dice rolled their highest face and earned a throw. The dice that are down stay down — shake to throw the %1$d they earned.</item>
  </plurals>
  <!--
    A roll that could not finish. It says how many dice never stopped and hands
    them back, rather than reading them off whatever face they were nearest
    (`docs/physics-and-rendering.md`).
  -->
  <string name="roll_stalled_kicker">COULD NOT SETTLE</string>
  <string name="roll_stalled_alert">Warning</string>
  <plurals name="roll_stalled">
    <item quantity="one">A die never stopped, so the roll has no total yet — %3$d of %2$d read and counted.</item>
    <item quantity="other">%1$d dice never stopped, so the roll has no total yet — %3$d of %2$d read and counted.</item>
  </plurals>
  <string name="roll_stalled_cancel">Cancel the roll</string>
  <!--
    Said over the tray the moment a roll starts waiting on a hand, and gone
    again 2.6 s later. The plate says the same thing and stays; this is the
    part a screen reader is told about without being asked (`ModernistToast`).
  -->
  <plurals name="roll_toast_stalled">
    <item quantity="one">Shake to throw that die again.</item>
    <item quantity="other">Shake to throw those %1$d dice again.</item>
  </plurals>
  <plurals name="roll_toast_earned">
    <item quantity="one">Shake to throw the die it earned.</item>
    <item quantity="other">Shake to throw the %1$d dice they earned.</item>
  </plurals>
  <plurals name="roll_tray_stalled">
    <item quantity="one">Dice tray, %1$d die would not settle</item>
    <item quantity="other">Dice tray, %1$d dice would not settle</item>
  </plurals>
  <!--
    The debug overlay, behind the developer toggle
    (`docs/physics-and-rendering.md`, "Debug tooling"). Developer-facing and
    deliberately terse: it is read at a glance while dice are moving, and every
    row is numbers.
  -->
  <string name="roll_debug_counters">step %1$d · at rest %2$d/%3$d</string>
  <string name="roll_debug_ladder">corr %1$d · rethrow %2$d · hits %3$d</string>
  <!-- Shown only when one has happened. Either number above zero is a bug. -->
  <string name="roll_debug_anomaly">BUG: forced %1$d · post-rest %2$d</string>
  <!--
    What a screen reader says where the drawing says it with a mark only an eye
    can read (`docs/architecture.md`, "Accessibility"). %1$s is the die's label.
  -->
  <string name="roll_die_natural_max">%1$s, highest face</string>
  <string name="roll_die_dropped">%1$s, dropped</string>
  <!--
    The tray itself. It is a drawing surface with nothing under it, so without
    these a screen reader finds an empty rectangle the size of the screen.
  -->
  <string name="roll_tray_empty">Dice tray, empty</string>
  <plurals name="roll_tray_ready">
    <item quantity="one">Dice tray, %1$d die ready to throw</item>
    <item quantity="other">Dice tray, %1$d dice ready to throw</item>
  </plurals>
  <plurals name="roll_tray_rolling">
    <item quantity="one">Dice tray, %1$d die rolling</item>
    <item quantity="other">Dice tray, %1$d dice rolling</item>
  </plurals>
  <plurals name="roll_tray_shake_again">
    <item quantity="one">Dice tray, %1$d die down, shake again for the one it earned</item>
    <item quantity="other">Dice tray, %1$d dice down, shake again for the one they earned</item>
  </plurals>
  <string name="roll_tray_settled">Dice tray, the dice have landed on %1$d</string>
  <!-- The panel that stands where the tray would be when the pictures are off. -->
  <string name="roll_power_saving">Power-saving mode</string>
  <string name="roll_power_saving_same">Same physics, no rendering. The result is identical to what the tray would show.</string>
  <string name="roll_debug_overlay">Debug overlay</string>
  <!-- The plan of the tray: how many dice, and how many in each of the three states. -->
  <plurals name="roll_debug_plan">
    <item quantity="one">Tray plan: %1$d die, %2$d at rest, %3$d moving, %4$d stacked</item>
    <item quantity="other">Tray plan: %1$d dice, %2$d at rest, %3$d moving, %4$d stacked</item>
  </plurals>
</resources>
