<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <string name="roll_formula_label">Formula</string>
  <!-- The set a group's dice actually came from, when it is not the one asked for. -->
  <string name="roll_group_fell_back">from %1$s</string>
  <!-- Division rounding, offered for this throw only (design option 6d). -->
  <string name="roll_rounding_label">Rounding</string>
  <string name="roll_rounding_down">Down</string>
  <string name="roll_rounding_nearest">Nearest</string>
  <string name="roll_rounding_up">Up</string>
  <!--
    Dice notation, not prose: the "-" is the subtraction operator the parser
    reads, and an en dash is not something the player could type back
    (`docs/dice-notation.md`).
  -->
  <string name="roll_formula_hint" tools:ignore="TypographyDashes">3d6 + 1d20 - 4</string>
  <!-- First launch (design option 9a). %1$d is how many dice sets are installed. -->
  <string name="roll_welcome_eyebrow">FIRST LAUNCH</string>
  <string name="roll_welcome_title">Nothing to set up.</string>
  <string name="roll_welcome_body">The dice are installed and the table is laid out. Shake the phone to roll, or press the button. Everything else — saved rolls, your own dice, statistics — waits in the menu until you want it.</string>
  <plurals name="roll_welcome_sets">
    <item quantity="one">%1$d dice set · 0 saved rolls</item>
    <item quantity="other">%1$d dice sets · 0 saved rolls</item>
  </plurals>
  <string name="roll_welcome_roll_now">Roll a d20 now</string>
  <string name="roll_welcome_dismiss">Just show me the tray</string>
  <!-- The hint on an empty tray, and on one with a throw ready (design option 9a). -->
  <string name="roll_hint_empty">Type a formula, or tap a die below.</string>
  <string name="roll_hint_ready">Shake the phone, or press Roll.</string>
  <!-- The dice picker row (design option 1h). %1$s is a die, e.g. "d20". -->
  <string name="roll_picker_add">Add a %1$s</string>
  <string name="roll_picker_remove">Take a %1$s off</string>
  <!-- The way to the outcome graph (design option 7a). -->
  <string name="roll_see_the_odds">See the odds</string>
  <string name="roll_throw">Roll</string>
  <string name="roll_again">Roll again</string>
  <string name="roll_rolling">Rolling…</string>
</resources>
