<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The dice-set list (design option 5a). -->
  <string name="sets_title">Dice sets</string>
  <string name="sets_order">What is installed. Long-press a set to switch it off or remove it.</string>
  <string name="sets_empty_title">Only the built-in dice.</string>
  <string name="sets_empty_body">Install a set and it appears here. Everything in one is checked before a single die of it is thrown.</string>

  <!-- Row status. -->
  <string name="sets_bundled">Built in</string>
  <string name="sets_disabled">Switched off</string>
  <string name="sets_broken">Will not load</string>
  <!-- %1$d is how many dice the set defines. -->
  <plurals name="sets_dice">
    <item quantity="one">1 die</item>
    <item quantity="other">%1$d dice</item>
  </plurals>
  <!-- %1$d is how many things the validator found wrong. -->
  <plurals name="sets_problems">
    <item quantity="one">1 problem</item>
    <item quantity="other">%1$d problems</item>
  </plurals>

  <!-- Installing (design option 1t). -->
  <string name="sets_install">Install from a file</string>
  <string name="sets_installing">Installing…</string>
  <string name="sets_installed">“%1$s” is installed.</string>
  <string name="sets_replaced">“%1$s” was replaced with this one.</string>
  <string name="sets_install_refused">Nothing was installed.</string>
  <string name="sets_install_warnings">It installed, with notes:</string>
  <string name="sets_install_close">Close</string>

  <!-- Set details (design options 6a and 6b). -->
  <string name="sets_detail_gone">This set is not installed.</string>
  <string name="sets_detail_gone_body">It may have been removed from another screen, or its folder taken away outside the app.</string>
  <string name="sets_detail_author">Author</string>
  <string name="sets_detail_license">Licence</string>
  <string name="sets_detail_source">Installed from</string>
  <string name="sets_detail_commit">Commit %1$s</string>
  <string name="sets_detail_source_unknown">Not recorded. This set was not installed by this app.</string>
  <string name="sets_detail_default">Roll these by default</string>
  <string name="sets_detail_is_default">Rolled by default</string>
  <string name="sets_detail_default_note">“d20” with no set in front of it comes from here, falling back to the built-in dice for anything this set does not define.</string>
  <string name="sets_detail_dice">Dice</string>
  <string name="sets_detail_report">What is wrong with it</string>
  <string name="sets_detail_report_note">The folder is kept, so an update can replace it. Nothing from this set is offered until it loads.</string>
  <!-- %1$d is how many faces the die has. -->
  <plurals name="sets_detail_faces">
    <item quantity="one">1 face</item>
    <item quantity="other">%1$d faces</item>
  </plurals>

  <!-- The long-press sheet (design option 5a). -->
  <string name="sets_sheet_disable">Switch off</string>
  <string name="sets_sheet_enable">Switch on</string>
  <string name="sets_sheet_disable_note">Keeps the folder and every statistic. Its dice stop being offered.</string>
  <string name="sets_sheet_remove">Remove</string>
  <string name="sets_sheet_remove_note">Deletes the folder. Statistics for its dice are kept.</string>
  <string name="sets_sheet_cancel">Cancel</string>
  <string name="sets_link_label">https://… a .zip or .tar.gz</string>
  <string name="sets_fetch">Fetch</string>
</resources>
