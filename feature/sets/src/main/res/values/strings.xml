<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
  <!-- The dice-set list (design option 5a). -->
  <string name="sets_title">Dice sets</string>
  <string name="sets_order">What is installed. Long-press a set to switch it off or remove it.</string>
  <string name="sets_empty_title">Only the built-in dice.</string>
  <string name="sets_empty_body">Install a set and it appears here. Everything in one is checked before a single die of it is thrown.</string>

  <!-- Row status. -->
  <string name="sets_bundled">Built in</string>
  <string name="sets_broken">Will not load</string>

  <!--
    The badges at the end of a row (design/dInfinityPhone.dc.html, lines
    444-446). Lower case, as the prototype writes them: a tag is a label on a
    row, not a sentence about it.

    The prototype's second word is "disabled"; this says "switched off" on
    purpose, because of what "disabled" means to a screen reader. The reason is
    written where the tags are drawn, in SetsScreen.Badges.
  -->
  <string name="sets_tag_default">default</string>
  <string name="sets_tag_disabled">switched off</string>

  <!-- %1$d is how many dice the set defines. -->
  <plurals name="sets_dice">
    <item quantity="one">1 die</item>
    <item quantity="other">%1$d dice</item>
  </plurals>
  <!-- %1$d is how many things the validator found wrong. -->
  <plurals name="sets_problems">
    <item quantity="one">1 problem</item>
    <item quantity="other">%1$d problems</item>
  </plurals>

  <!--
    Section kickers: the accent line that says what the block under it is
    (`design/dInfinityPhone.dc.html`, the Dice sets screen).
  -->
  <string name="sets_kicker_install">Install from a URL or file</string>
  <string name="sets_kicker_installed">Installed</string>

  <!-- Installing (design option 1t). -->
  <string name="sets_install">Install from a file</string>
  <string name="sets_installing">Installing…</string>
  <string name="sets_installed">“%1$s” is installed.</string>
  <string name="sets_replaced">“%1$s” was replaced with this one.</string>
  <string name="sets_install_refused">Nothing was installed.</string>
  <string name="sets_install_warnings">It installed, with notes:</string>
  <!-- %1$d is how many things the validator refused the package over. -->
  <plurals name="sets_install_errors">
    <item quantity="one">1 error</item>
    <item quantity="other">%1$d errors</item>
  </plurals>
  <string name="sets_install_close">Close</string>

  <!-- Set details (design options 6a and 6b). -->
  <string name="sets_detail_gone">This set is not installed.</string>
  <string name="sets_detail_gone_body">It may have been removed from another screen, or its folder taken away outside the app.</string>
  <string name="sets_detail_author">Author</string>
  <string name="sets_detail_license">Licence</string>
  <string name="sets_detail_source">Installed from</string>
  <string name="sets_detail_commit">Commit %1$s</string>
  <string name="sets_detail_source_unknown">Not recorded. This set was not installed by this app.</string>
  <string name="sets_detail_default">Roll these by default</string>
  <string name="sets_detail_is_default">Rolled by default</string>
  <string name="sets_detail_default_note">“d20” with no set in front of it comes from here, falling back to the built-in dice for anything this set does not define.</string>
  <!-- %1$d is how many dice the set defines. -->
  <!--
    The Physical block (design/dInfinityPhone.dc.html, the Dice set details
    screen; docs/dice-sets.md, "Weight, translucency and size, as a person sets
    them"). A set file writes density, translucency and size_mm; these are the
    same three said the way a dice shop says them.
  -->
  <string name="sets_detail_physical">Physical</string>
  <string name="sets_detail_weight">Weight</string>
  <string name="sets_detail_weight_note">Per die, as the set declares it. Heavier dice come to rest sooner on the table.</string>
  <string name="sets_detail_translucency">Translucency</string>
  <string name="sets_detail_translucency_note">numerals stay solid so a read is never in doubt.</string>
  <string name="sets_detail_opaque">Opaque</string>
  <string name="sets_detail_see_through">Lets the table through</string>
  <string name="sets_detail_size">Size</string>
  <!-- Not a format string: the two per-cent signs are what it says, not where a number goes. -->
  <string name="sets_detail_size_note" formatted="false">50 % to 150 % of an average die. Affects how many fit the table.</string>
  <string name="sets_detail_size_average">Average</string>
  <!-- %1$s is how far over or under the average die these are, as a per cent. -->
  <string name="sets_detail_size_over">%1$.0f %% over average</string>
  <string name="sets_detail_size_under">%1$.0f %% under average</string>
  <!-- A word about the figure, then the sentence under it. -->
  <string name="sets_detail_note_joined">%1$s · %2$s</string>
  <!--
    The figures themselves. A set is a bag of dice and they need not agree — a
    d4 and a d20 of one size are never the same weight — so each is printed as
    a range whenever its ends differ.
  -->
  <string name="sets_detail_grams">%1$.1f g</string>
  <string name="sets_detail_grams_range">%1$.1f–%2$.1f g</string>
  <string name="sets_detail_percent">%1$.0f %%</string>
  <string name="sets_detail_percent_range">%1$.0f–%2$.0f %%</string>
  <!--
    The steppers, which only "My dice" has. The glyphs are the prototype's; the
    names are what a screen reader says, because a button whose label is a
    picture has no words of its own.
  -->
  <string name="sets_detail_step_down">−</string>
  <string name="sets_detail_step_up">+</string>
  <string name="sets_detail_lighter">Lighter</string>
  <string name="sets_detail_heavier">Heavier</string>
  <string name="sets_detail_less_translucent">Less translucent</string>
  <string name="sets_detail_more_translucent">More translucent</string>
  <string name="sets_detail_smaller">Smaller</string>
  <string name="sets_detail_bigger">Bigger</string>
  <string name="sets_detail_physical_fixed">Declared in the set\'s diceset.toml — an imported set is read-only. Draw your own dice to set these yourself.</string>

  <string name="sets_detail_dice">Dice · %1$d · rendered from the set</string>
  <string name="sets_detail_report">Validation report</string>
  <string name="sets_detail_export">Export as zip</string>
  <string name="sets_detail_export_note">Pick a licence before sharing; it is written into diceset.toml. The zip can be uploaded to a git repository as-is.</string>
  <string name="sets_detail_license_choose">Licence — choose one</string>
  <string name="sets_detail_export_do">Export</string>
  <string name="sets_detail_exported">%1$s shared — upload it to any git repository as-is.</string>
  <string name="sets_detail_report_note">The folder is kept, so an update can replace it. Nothing from this set is offered until it loads.</string>
  <!-- %1$d is how many faces the die has. -->
  <plurals name="sets_detail_faces">
    <item quantity="one">1 face</item>
    <item quantity="other">%1$d faces</item>
  </plurals>

  <!-- The long-press sheet (design option 5a). -->
  <string name="sets_sheet_disable">Switch off</string>
  <string name="sets_sheet_enable">Switch on</string>
  <string name="sets_sheet_disable_note">Keeps the folder and every statistic. Its dice stop being offered.</string>
  <string name="sets_sheet_remove">Remove</string>
  <string name="sets_sheet_remove_note">Deletes the folder. Statistics for its dice are kept.</string>
  <string name="sets_sheet_cancel">Cancel</string>
  <string name="sets_link_label">https://… a .zip or .tar.gz</string>
  <string name="sets_cancel">Cancel</string>
  <string name="sets_fetch">Fetch</string>
  <string name="sets_check">Check for updates</string>
  <string name="sets_checking">Checking…</string>
  <!-- %1$d is how many installed sets could be asked about. -->
  <plurals name="sets_check_current">
    <item quantity="one">1 set checked; it is up to date.</item>
    <item quantity="other">%1$d sets checked; all up to date.</item>
  </plurals>
  <!-- %1$d is how many installed sets have something newer at their forge. -->
  <plurals name="sets_check_outdated">
    <item quantity="one">1 set has something newer.</item>
    <item quantity="other">%1$d sets have something newer.</item>
  </plurals>
  <!-- %1$d is how many forges did not answer. -->
  <plurals name="sets_check_unreachable">
    <item quantity="one">1 set could not be checked.</item>
    <item quantity="other">%1$d sets could not be checked.</item>
  </plurals>
  <string name="sets_sheet_update">Update</string>
  <string name="sets_outdated">Update available</string>
  <!--
    The download bar, for a screen reader: a bar is a picture of a number, and
    the number is what it cannot see (`docs/architecture.md`, "Accessibility").
  -->
  <string name="sets_downloading">Downloading</string>
  <string name="sets_downloading_far">Downloading, %1$d %%</string>
  <!-- What tapping the source of a set does, for a screen reader. -->
  <string name="sets_detail_source_open">Open in a browser</string>
</resources>
