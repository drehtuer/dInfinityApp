  <plurals name="sets_dice">
    <item quantity="one">1 die</item>
    <item quantity="other">%1$d dice</item>
  </plurals>
  <!-- %1$d is how many things the validator found wrong. -->
  <plurals name="sets_problems">
    <item quantity="one">1 problem</item>
    <item quantity="other">%1$d problems</item>
  </plurals>

