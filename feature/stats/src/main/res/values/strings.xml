  <string name="history_title">History</string>
  <string name="history_empty_title">No rolls yet.</string>
  <string name="history_empty_body">Every throw is written down here with what it was made of. Nothing leaves the phone.</string>
  <!-- %1$s is the set the formula asked for, %2$s the one that supplied the dice. -->
  <!-- A number the formula added or took away, itemised under a past roll. -->
  <string name="history_plus">plus</string>
