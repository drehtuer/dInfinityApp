<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The history screen (design option 1x). -->
  <string name="history_title">History</string>
  <string name="history_empty_title">No rolls yet.</string>
  <string name="history_empty_body">Every throw is written down here with what it was made of. Nothing leaves the phone.</string>
  <!-- %1$s is the set the formula asked for, %2$s the one that supplied the dice. -->
  <string name="history_fell_back">“%1$s” is not installed; the dice came from “%2$s”</string>
  <!-- %1$d is how many dice had to be thrown again or were forced to settle. -->
  <plurals name="history_anomalies">
    <item quantity="one">One correction during this throw</item>
    <item quantity="other">%1$d corrections during this throw</item>
  </plurals>
  <string name="history_all">Everything</string>
  <string name="history_filtered_empty">Nothing matches that yet.</string>
  <string name="history_clear_filter">Show everything</string>

  <!-- The statistics screen (design option 1w). -->
  <string name="stats_title">Statistics</string>
  <!-- Saved-roll statistics (design options 8b and 9e). -->
  <string name="savedstats_title">Saved-roll statistics</string>
  <string name="savedstats_order">What each roll has actually come to, against what the maths says it should.</string>
  <string name="savedstats_empty_title">No saved rolls in this group.</string>
  <string name="savedstats_empty_body">Save a roll and every throw of it is counted here, against its exact distribution.</string>
  <string name="savedstats_never">Never rolled</string>
  <string name="savedstats_expected">Expected %1$s</string>
  <string name="savedstats_rolled">Rolled %1$s</string>
  <string name="savedstats_range">Range %1$d to %2$d, of a possible %3$d to %4$d</string>
  <string name="savedstats_range_observed">Range %1$d to %2$d</string>
  <string name="savedstats_worth_a_look">That average is further from expectation than most runs of this length get. Worth a look, not a verdict.</string>
  <string name="savedstats_too_few">Too few throws to say anything about the average yet.</string>
  <string name="savedstats_back">Back</string>
  <!-- %1$d is how many times the roll has been thrown. -->
  <plurals name="savedstats_throws">
    <item quantity="one">1 throw</item>
    <item quantity="other">%1$d throws</item>
  </plurals>

  <string name="stats_all_sets">All sets</string>
  <string name="stats_across_sets">All my d20s</string>
  <string name="stats_across_sets_note">Every set’s dice of each kind, counted together. The fair line weighs each die by how often it was thrown.</string>
  <string name="stats_filtered_empty">No dice from that set have been thrown yet.</string>
  <string name="stats_order">Every die you have thrown, most recently used first. Tap one for its histogram.</string>
  <string name="stats_empty_title">Nothing thrown yet.</string>
  <string name="stats_empty_body">Roll some dice and this fills in: how often each face has come up, against how often a fair die would.</string>
  <!-- %1$d is how many times the die has been thrown. -->
  <plurals name="stats_throws">
    <item quantity="one">%1$d throw</item>
    <item quantity="other">%1$d throws</item>
  </plurals>
  <!-- %1$s is the id of a set that is no longer installed. -->
  <string name="stats_set_gone">%1$s — not installed</string>
  <!-- %1$d is the die's own highest value: 20 for a d20, 3 for a d6 labelled 1,2,3,1,2,3. -->
  <string name="stats_natural_high">natural %1$d</string>
  <string name="stats_natural_low">natural %1$d</string>
  <string name="stats_average">average</string>
  <string name="stats_total_throws">throws</string>
  <string name="stats_guessed_line">That set is not installed, so the fair line is guessed from what has come up rather than from the die’s faces.</string>
  <string name="stats_reset_die">Forget this die’s record</string>
  <string name="stats_reset_all">Forget everything</string>
  <string name="stats_confirm_title">This cannot be undone</string>
  <!-- %1$s is the die's name. -->
  <string name="stats_confirm_die">Every throw of %1$s is forgotten: its counts, its averages and its streaks. Your history of past rolls is left alone.</string>
  <string name="stats_confirm_all">Every die’s record and every roll in your history is forgotten.</string>
  <string name="stats_confirm_yes">Forget it</string>
  <string name="group_cancel_stats">Keep it</string>
  <!-- Sessions (design option 6c). -->
  <string name="sessions_title">Sessions</string>
  <!-- The session every roll belongs to before anybody makes another. -->
  <string name="sessions_first">First rolls</string>
  <string name="sessions_explanation">A session is a label on a stretch of rolls — a campaign, an evening. Nothing starts or stops; new rolls go into whichever one is chosen.</string>
  <string name="sessions_new">New session</string>
  <string name="sessions_new_note">New rolls go here from now on.</string>
  <string name="sessions_rename">Rename</string>
  <string name="sessions_delete">Delete</string>
  <string name="sessions_name">Name</string>
  <string name="sessions_name_hint">Tuesday campaign</string>
  <string name="sessions_save">Save</string>
  <string name="sessions_cancel">Cancel</string>
  <!-- %1$s is the session name; this marks the one new rolls go into. -->
  <string name="sessions_active">%1$s — rolling into this one</string>
  <!-- %1$s is a number of rolls, %2$s a number of natural maximums. -->
  <string name="sessions_counts">%1$s, %2$s</string>
  <plurals name="sessions_rolls">
    <item quantity="one">%1$d roll</item>
    <item quantity="other">%1$d rolls</item>
  </plurals>
  <plurals name="sessions_naturals">
    <item quantity="one">%1$d with a natural high</item>
    <item quantity="other">%1$d with a natural high</item>
  </plurals>
</resources>
