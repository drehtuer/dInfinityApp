<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
  <string name="designer_roll">Roll it</string>
  <string name="designer_title">Face designer</string>
  <!-- Under the title: which face is on the canvas. %1$s is a face's label, like "3" or "crit", %2$d how many the die has. -->
  <string name="designer_which_face">Face %1$s of %2$d</string>
  <!-- What a screen reader says for one square of the face strip. %1$s is the face's label. -->
  <string name="designer_face">Face %1$s</string>
  <!-- The footer action that writes the drawings into a dice set. -->
  <string name="designer_save">Save to set</string>
  <string name="designer_save_title">Save to set</string>
  <!-- Why the list is as short as it is: an installed set belongs to whoever wrote it. -->
  <string name="designer_save_where">Only a set this phone made can be written to.</string>
  <string name="designer_save_do">Save</string>
  <string name="designer_save_close">Close</string>
  <!-- Building the set draws every face of every die, which takes a moment. -->
  <string name="designer_save_busy">Drawing the set…</string>
  <!-- %1$s is the set's name, like "My dice". -->
  <string name="designer_save_done">Saved to %1$s. Roll it now throws the drawing.</string>
  <string name="designer_save_blank">There is nothing drawn to save yet.</string>
  <string name="designer_save_refused">That could not be written, and nothing was changed.</string>
  <!-- The last choice in the Save to set sheet: make a personal set of your own and save into it. -->
  <string name="designer_save_new">New set…</string>
  <!-- The label of the field the new set's name is typed into. -->
  <string name="designer_save_new_name">Name of the new set</string>
  <!-- Under the name field. %1$s is the id the name comes to, like "brass-bone"; it is what notation calls the set. -->
  <string name="designer_save_new_id">Its id will be %1$s: that is what notation calls the set.</string>
  <!-- Why a new set was not made. %1$s is the id the name came to, like "me". -->
  <string name="designer_save_new_unnamed">A new set needs a name.</string>
  <string name="designer_save_new_long">That name is too long: a set’s name has at most 40 characters.</string>
  <string name="designer_save_new_bad_id">A set’s id is made from its name and needs 3 to 40 letters and digits; this name comes to “%1$s”. Try a longer name.</string>
  <string name="designer_save_new_taken">There is already a set with the id “%1$s” on this phone. Choose another name.</string>
  <string name="designer_save_new_refused">That set could not be made, and nothing was changed.</string>
  <!-- The flat editor, where a face is drawn one at a time. -->
  <string name="designer_view_face">Face</string>
  <!-- The die itself, turned over in the hand. -->
  <string name="designer_view_solid">Solid</string>
  <!-- Whether the die turns on its own. Dragging it turns this off. -->
  <string name="designer_spin">Spin</string>
  <!-- What the die on the Solid tab is: %1$s is a die's name, like "d20", %2$d how many faces it has. -->
  <plurals name="designer_solid_stage">
    <item quantity="one">%1$s, %2$d face. Drag to turn it.</item>
    <item quantity="other">%1$s, %2$d faces. Drag to turn it.</item>
  </plurals>
  <!-- Said beside the turning die: what it shows, and how to turn it. -->
  <string name="designer_solid_note">Everything drawn, on the real solid. Drag to turn it.</string>
  <!-- The kicker over the menu of what the die is made of, on the Solid tab. -->
  <string name="designer_material">Material</string>
  <!-- What a screen reader says for the Material menu. %1$s is the material chosen, like "Glass". -->
  <string name="designer_material_described">Material: %1$s</string>
  <!-- The materials a die can be made of. Each is a look on the tray and the name a player would give it. -->
  <string name="designer_material_plastic">Plastic</string>
  <!-- Milky, a little see-through: mother of pearl, or cloudy resin. -->
  <string name="designer_material_pearl">Pearl</string>
  <!-- Clear-ish cast resin, the felt showing through it. -->
  <string name="designer_material_resin">Resin</string>
  <string name="designer_material_glass">Glass</string>
  <string name="designer_material_metal">Metal</string>
  <!-- Matte, like a die cut from stone. -->
  <string name="designer_material_stone">Stone</string>
  <!-- Shown when the die's material is none of the names: one copied from somebody else's set. -->
  <string name="designer_material_custom">Custom</string>
  <!-- The kicker over the die's body colour: what every face is drawn on and what shows at the rounded edges. -->
  <string name="designer_body">Colour</string>
  <!-- What a screen reader says for one of the body colours. %1$s is the colour as hex, like "#EC3013". -->
  <string name="designer_body_colour">Body colour %1$s</string>
  <!-- The swatch after the twelve, which opens the picker for the body colour. %1$s is the colour now. -->
  <string name="designer_body_more">More body colours, now %1$s</string>
  <!-- The title of the picker the body colour is chosen in. -->
  <string name="designer_body_title">Colour of the die</string>
  <!-- The kicker over the choice of how round the die's edges are. -->
  <string name="designer_edges">Edges</string>
  <!-- Under the Edges slider, and what a screen reader says it stands at. %1$.1f is the per cent of the die's size, %2$.2f the millimetres that comes to on this die. -->
  <string name="designer_edges_value">Rounded by %1$.1f %% of its size: %2$.2f mm</string>
  <!-- Under the controls: the swatch is a hint, the tray is the real thing. -->
  <string name="designer_finish_note">Roll it to see the material on the tray. Rounder dice tumble a little longer.</string>
  <string name="designer_nib_fine">Fine</string>
  <string name="designer_nib_medium">Medium</string>
  <string name="designer_nib_broad">Broad</string>
  <string name="designer_eraser">Eraser</string>
  <string name="designer_bucket">Fill</string>
  <string name="designer_stamp">Stamp</string>
  <!-- The field holding what the stamp will put on the face: a digit, a sign. -->
  <string name="designer_stamp_text">What to stamp</string>
  <string name="designer_stamp_small">Small</string>
  <string name="designer_stamp_medium">Medium</string>
  <string name="designer_stamp_large">Large</string>
  <string name="designer_stamp_refused">The built-in font draws 0–9 and a few signs. Anything else has to be drawn by hand.</string>
  <!-- One tap that puts every face's own number on it, as a starting point. -->
  <string name="designer_fill_numbers">Fill all with numbers</string>
  <!-- One tap that puts the standard pips on all six faces of a d6. "Eyes" is what the dots on a die are called. -->
  <string name="designer_fill_eyes">Fill all with eyes</string>
  <string name="designer_undo">Undo</string>
  <string name="designer_redo">Redo</string>
  <!-- Takes everything off the face being drawn on — strokes, fills, numbers, eyes — and leaves the other faces alone. Undo brings it back. -->
  <string name="designer_clear_face">Clear face</string>
  <!-- The switch for the faint number under the drawing, to trace. A word, because the picture it had was read as "load an image". -->
  <string name="designer_guide">Guide</string>
  <string name="designer_face_nearly_full">This face is nearly full — a few strokes left.</string>
  <string name="designer_face_full">This face is full. Undo something, or clear it and start again.</string>
  <string name="designer_copy">Copy face</string>
  <string name="designer_paste">Paste</string>
  <!-- Which of a cell's own turns a pasted face lands on: the first of four, say. -->
  <string name="designer_turn">Turn %1$d/%2$d</string>
  <string name="designer_mirror">Mirror</string>
  <!-- The label a screen reader reads for one colour of the palette. -->
  <string name="designer_ink">Ink %1$s</string>
  <string name="designer_colour_more">More colours, now %1$s</string>
  <!--
    What the shared colour picker is called when it is the pen being coloured.
    The sheet's title is this screen's word for it; everything inside the sheet
    is `ui/common`'s, because a hue is a hue on every screen.
  -->
  <string name="designer_colour_title">Pick a colour</string>
</resources>
