<?xml version="1.0" encoding="utf-8"?>
<!--
  Statistics, saved rolls and installed dice sets are the player's, and nothing
  leaves the phone (docs/statistics.md). So: no cloud backup at all, but a
  device-to-device transfer may carry everything, because swapping phones
  should not cost you your campaign's history.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="file" path="." />
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
