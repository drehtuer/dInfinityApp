<?xml version="1.0" encoding="utf-8"?>
<!--
  The two directories something on its way out of the app is copied into: a
  saved-roll collection, and a file of numbers from the history or the
  statistics. Nothing else in the app's storage is reachable through this
  provider: a file-sharing provider that can see the database is a
  file-sharing provider that will one day be asked for it.
-->
<paths>
  <cache-path name="collections" path="collections/" />
  <cache-path name="exports" path="exports/" />
</paths>
